# RunPod Configuration
# Get your API key from: https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=your_runpod_api_key_here

# After deploying your handler to RunPod, you'll get a new endpoint ID
RUNPOD_ENDPOINT_ID=your_endpoint_id_here

# Flask Configuration
UPLOAD_FOLDER=static/uploads
RESULTS_FOLDER=static/results
MAX_CONTENT_LENGTH=104857600  # 100MB
FLASK_ENV=development

# Generate a random secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here
